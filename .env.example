# Django Settings
DJANGO_KEY=
DEBUG=True
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Allowed origins
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=True

# Database Settings
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 3rd Party API Keys
# GitHub sign-in only works where the OAuth app's callback URL points. The live
# app points at dashboard.mysticdie.com, so leave these blank unless you create
# a SECOND OAuth app with the localhost callback below. Everything that does not
# need a signed-in user runs fine without them.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the "Authorization callback URL" on the GitHub OAuth app exactly.
# Leave blank to derive it from the incoming request.
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/user/github/callback/

# GitHub org gate + hardcoded admins (comma-separated GitHub usernames)
GITHUB_ORG=Mystic-Die-Studios
ADMIN_GITHUB_USERNAMES=

# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:5173

# Session Settings
# Leave SESSION_COOKIE_SECURE off for local http dev; turn it on in production.
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_SECURE=False
# Use None (with SESSION_COOKIE_SECURE=True) if the frontend and API sit on
# different registrable domains in production.
AUTH_COOKIE_SAMESITE=Lax
