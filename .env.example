# Django Settings
DJANGO_KEY=
DEBUG=
# DB_ENGINE=sqlite bypasses MySQL for fast local/CI test runs. Leave blank/unset for MySQL.
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Allowed origins
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Frontend base URL (OAuth callback redirects here after login)
FRONTEND_URL=http://localhost:5173

# Database Settings
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 3rd Party API Keys / GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the callback URL registered on the GitHub OAuth App.
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback/
# Restrict login to active members of this org. Leave blank to allow any GitHub user.
GITHUB_REQUIRED_ORG=Mystic-Die-Studios

# Issue Kanban bridge (server-to-server integration; see kanban_app)
# Full URL to the Kanban app's bridge endpoint. Note: the Kanban app also dev-runs
# on :8000, so give it a different port locally (e.g. 8001) to avoid colliding with Django.
KANBAN_BRIDGE_URL=http://localhost:8001/api/bridge.php
# Must equal BRIDGE_SECRET in the Kanban app's config (config.local.php / config.php).
KANBAN_BRIDGE_SECRET=

# Session Settings
SESSION_COOKIE_SECURE=
SESSION_COOKIE_HTTPONLY=
CSRF_COOKIE_SECURE=