# Production .env for dashboard.mysticdie.com
#
# Copy this to the app root on the server as ~/employee-dashboard/.env and fill
# in the blanks. Never commit the filled-in version.

# Django Settings
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_KEY=
DEBUG=False

# cPanel > MySQL Databases. Names are prefixed with your cPanel username,
# e.g. mysticd_dashboard / mysticd_dashuser.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Allowed origins
ALLOWED_HOSTS=dashboard.mysticdie.com
CORS_ALLOWED_ORIGINS=https://dashboard.mysticdie.com
CSRF_TRUSTED_ORIGINS=https://dashboard.mysticdie.com
CORS_ALLOW_CREDENTIALS=True

# 3rd Party API Keys
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the OAuth app's Authorization callback URL character for character.
GITHUB_REDIRECT_URI=https://dashboard.mysticdie.com/api/v1/user/github/callback/

# GitHub org gate + hardcoded admins (comma-separated GitHub usernames)
GITHUB_ORG=Mystic-Die-Studios
ADMIN_GITHUB_USERNAMES=

# The API and the React app share this origin, so this is just the site root.
FRONTEND_URL=https://dashboard.mysticdie.com

# Session Settings
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_SECURE=True
# Same origin for app and API, so Lax is correct and strictest-workable.
AUTH_COOKIE_SAMESITE=Lax

# cPanel terminates TLS in front of Passenger.
TRUST_PROXY_SSL_HEADER=True
# Leave False if you already force https in cPanel/.htaccess; setting both is
# harmless but only one is needed.
SECURE_SSL_REDIRECT=False
# Opt in only after https is confirmed working. Browsers cache this for the
# full duration and will refuse plain http until it expires.
SECURE_HSTS_SECONDS=0
